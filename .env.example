# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Use a long random password in production; never commit the real .env file.
POSTGRES_DB=uaat
POSTGRES_USER=uaat
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://uaat:replace-with-a-long-random-secret@db:5432/uaat

# Optional. Use a least-privilege token; never expose it to the browser.
GITHUB_TOKEN=

# Exact hostnames you own and explicitly authorize for health checks, comma-separated.
# Example: status.example.com,agent-api.example.com
# Do not use wildcards. Endpoints must use HTTPS and resolve only to public IPs.
MONITOR_ALLOWED_HOSTS=

# Bind the container to all interfaces internally; Compose exposes host loopback only.
HOST=0.0.0.0
PORT=8000
DISCOVERY_INTERVAL_MINUTES=30
ENDPOINT_CHECK_INTERVAL_MINUTES=5
GITHUB_SEARCH_QUERY=topic:ai-agent
